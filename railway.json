{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/Dockerfile.f1"
  },
  "deploy": {
    "startCommand": "uvicorn feature_1_ia_personalizada.api.app:app --host 0.0.0.0 --port $PORT --workers 2 --log-level info",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
