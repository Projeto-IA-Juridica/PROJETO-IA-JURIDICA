{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/Dockerfile.f1"
  },
  "deploy": {
    "startCommand": "celery -A feature_1_ia_personalizada.workers.celery_app worker --loglevel=info --concurrency=2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}