          "legendFormat": "p95 custo — {{intencao}}",
          "refId": "A"
        }
      ],
      "title": "Custo p95 por Interação IA (USD)",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 102, "title": "Webhook WhatsApp", "type": "row" },

