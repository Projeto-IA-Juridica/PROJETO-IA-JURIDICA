          "expr": "rate(rag_embedding_cache_hits_total[5m]) / (rate(rag_embedding_cache_hits_total[5m]) + sum(rate(rag_embedding_seconds_count[5m])))",
          "legendFormat": "Cache Hit Rate",
          "refId": "A"
        }
      ],
