# =============================================================================
# CONCIERGE JURÍDICO DIGITAL — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no Git!
# =============================================================================

# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Opções: development | staging | production

LOG_LEVEL=INFO
# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://concierge:concierge_pass@localhost:5432/concierge_dev
# Em produção: usar RDS Multi-AZ com SSL
# Exemplo produção: postgresql+asyncpg://user:pass@rds-host:5432/concierge?ssl=require

# -----------------------------------------------------------------------------
# CACHE (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CELERY (Workers assíncronos)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# IA — ANTHROPIC CLAUDE
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Obter em: https://console.anthropic.com/
# Custo médio: ~R$ 0.10 por interação

# -----------------------------------------------------------------------------
# IA — OPENAI WHISPER (Transcrição de áudios WhatsApp)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Obter em: https://platform.openai.com/api-keys
# Custo: $0.006 por minuto de áudio

# -----------------------------------------------------------------------------
# WHATSAPP — EVOLUTION API
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
# Em produção: URL do seu servidor Evolution API self-hosted
EVOLUTION_API_KEY=sua-api-key-evolution
# Configurar na interface do Evolution API

# -----------------------------------------------------------------------------
# PROCESSOS JUDICIAIS — JUSBRASIL
# -----------------------------------------------------------------------------
JUSBRASIL_API_KEY=sua-api-key-jusbrasil
# Obter em: https://api.jusbrasil.com.br
# Custo: R$ 1,50 por processo/mês (monitoramento)

# -----------------------------------------------------------------------------
# SEGURANÇA — JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-de-pelo-menos-32-chars
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# -----------------------------------------------------------------------------
# SEGURANÇA — CRIPTOGRAFIA (AES-256 para dados sensíveis como CPF)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=troque-por-chave-fernet-base64-urlsafe-32-bytes
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# -----------------------------------------------------------------------------
# MONITORAMENTO — SENTRY (Erros em produção)
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Obter em: https://sentry.io — deixar vazio em desenvolvimento

# -----------------------------------------------------------------------------
# MONITORAMENTO — GRAFANA CLOUD (Prometheus Remote Write)
# -----------------------------------------------------------------------------
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push
# URL do endpoint Prometheus do stack Grafana Cloud (não alterar)
GRAFANA_CLOUD_PROMETHEUS_USERNAME=3014192
# ID numérico da instância Prometheus (aba "Details" no stack do Grafana Cloud)
GRAFANA_CLOUD_API_KEY=
# API Token com role "MetricsPublisher" gerado em grafana.com → My Account → API Keys

# =============================================================================
# VARIÁVEIS OPCIONAIS (Features futuras)
# =============================================================================

# Feature 2 — Projuris
# PROJURIS_CLIENT_ID=
# PROJURIS_CLIENT_SECRET=
# PROJURIS_REDIRECT_URI=http://localhost:8000/auth/projuris/callback

# Feature 5 — Stripe (Pagamentos)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_BASICO=price_...
# STRIPE_PRICE_ID_PROFISSIONAL=price_...

# Feature 5 — AWS S3 (Documentos)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=sa-east-1
# S3_BUCKET_DOCS=concierge-documentos

# Feature 5 — Firebase (Push notifications)
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-credentials.json


# Feature Harvey — Hub do Advogado
# Confirmar endpoint e modelo com a equipe Harvey antes de usar.
# HARVEY_HABILITADO=False por padrão (feature flag global).
# O controle por escritório é feito via campo harvey_habilitado no banco.
# HARVEY_API_KEY=sk-harvey-...
# HARVEY_API_URL=https://api.harvey.ai/v1
# HARVEY_MODELO=harvey-v3
# HARVEY_TIMEOUT=45
# HARVEY_HABILITADO=False
