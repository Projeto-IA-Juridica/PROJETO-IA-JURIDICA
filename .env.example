# =============================================================================
# CONCIERGE JURÍDICO DIGITAL — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no Git!
# =============================================================================

# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Opções: development | staging | production

# CORS_ALLOWED_ORIGINS=https://app.conciergejuridico.com,https://admin.conciergejuridico.com,https://projeto-ia-juridica-production-4bb1.up.railway.app
# Em produção, todas as origens precisam incluir esquema (https://)

LOG_LEVEL=INFO
# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://concierge:concierge_pass@localhost:5432/concierge_dev
# Em produção: usar RDS Multi-AZ com SSL
# Exemplo produção: postgresql+asyncpg://user:pass@rds-host:5432/concierge?ssl=require

# -----------------------------------------------------------------------------
# CACHE (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CELERY (Workers assíncronos)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# IA — ANTHROPIC CLAUDE
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Obter em: https://console.anthropic.com/
# Custo médio: ~R$ 0.10 por interação

# -----------------------------------------------------------------------------
# IA — OPENAI WHISPER (Transcrição de áudios WhatsApp)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Obter em: https://platform.openai.com/api-keys
# Custo: $0.006 por minuto de áudio

# -----------------------------------------------------------------------------
# WHATSAPP — EVOLUTION API
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
# Em produção: URL do seu servidor Evolution API self-hosted
EVOLUTION_API_KEY=sua-api-key-evolution
# Configurar na interface do Evolution API

# -----------------------------------------------------------------------------
# PROCESSOS JUDICIAIS — DATAJUD (CNJ)
# -----------------------------------------------------------------------------
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
# Chave pública oficial do CNJ para a API DataJud (api_publica_*)
# Documentação: https://datajud-wiki.cnj.jus.br/api-publica/
# Esta chave é pública e gratuita — funciona para todos os tribunais

# -----------------------------------------------------------------------------
# PROCESSOS JUDICIAIS — JUSBRASIL (legado)
# -----------------------------------------------------------------------------
# JUSBRASIL_API_KEY=sua-api-key-jusbrasil

# -----------------------------------------------------------------------------
# SEGURANÇA — JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-de-pelo-menos-32-chars
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_DAYS=7

# -----------------------------------------------------------------------------
# SEGURANÇA — CRIPTOGRAFIA (AES-256 para dados sensíveis como CPF)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=troque-por-chave-fernet-base64-urlsafe-32-bytes
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# -----------------------------------------------------------------------------
# MONITORAMENTO — SENTRY (Erros em produção)
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Obter em: https://sentry.io — deixar vazio em desenvolvimento

# -----------------------------------------------------------------------------
# MONITORAMENTO — GRAFANA CLOUD (Prometheus Remote Write)
# -----------------------------------------------------------------------------
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push
# URL do endpoint Prometheus do stack Grafana Cloud (não alterar)
GRAFANA_CLOUD_PROMETHEUS_USERNAME=3014192
# ID numérico da instância Prometheus (aba "Details" no stack do Grafana Cloud)
GRAFANA_CLOUD_API_KEY=
# API Token com role "MetricsPublisher" gerado em grafana.com → My Account → API Keys

# =============================================================================
# VARIÁVEIS OPCIONAIS (Features futuras)
# =============================================================================

# Feature 3 — Vibe Prospecting / Explorium AgentSource (enriquecimento B2B)
# Alternativa ao LinkedIn Partner Program para encontrar decisores de empresas.
# Criar conta e obter chave em: https://developers.explorium.ai
# EXPLORIUM_API_KEY=

# Feature 2 — Projuris
# PROJURIS_CLIENT_ID=
# PROJURIS_CLIENT_SECRET=
# PROJURIS_REDIRECT_URI=http://localhost:8000/auth/projuris/callback

# Feature 5 — Stripe (Pagamentos)
# Em dev: stripe listen --forward-to localhost:8000/api/v1/billing/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs criados no Stripe Dashboard → Products → Prices (recorrente mensal BRL)
STRIPE_PRICE_ID_BASICO=price_...        # Starter  — R$ 497/mês
STRIPE_PRICE_ID_PROFISSIONAL=price_...  # Profissional — R$ 1.997/mês
STRIPE_PRICE_ID_ESCRITORIO=price_...    # Escritório — R$ 4.997/mês
# URLs de retorno após checkout
STRIPE_SUCCESS_URL=http://localhost:5173/onboarding?stripe_return=1
STRIPE_CANCEL_URL=http://localhost:5173/planos?cancelado=1
STRIPE_TRIAL_DAYS=7

# Feature 5 — AWS S3 (Documentos)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=sa-east-1
# S3_BUCKET_DOCS=concierge-documentos

# Feature 5 — Firebase (Push notifications)
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-credentials.json


# =============================================================================
# FRONTEND (Vite — hub-react)
# =============================================================================
# Estas variáveis ficam em frontend/hub-react/.env (prefixo VITE_ obrigatório).
# Ver também: frontend/hub-react/.env.example

# Número WhatsApp de suporte da equipe amicus (DDI+DDD+número, sem espaços)
# VITE_SUPORTE_WHATSAPP=5500000000000

# Modelo de Escalação — Hub do Advogado
# Modelo Claude usado quando o ConfidenceRouter escalona (score baixo).
# ESCALACAO_HABILITADO=False por padrão (feature flag global).
# O controle por escritório é feito via campo escalacao_habilitada no banco.
# MODELO_ESCALACAO=claude-opus-4-6
# ESCALACAO_HABILITADO=False
